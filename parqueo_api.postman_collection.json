{
  "info": {
    "_postman_id": "parkingo-saas-api-v1",
    "name": "ParkinGo SaaS API v1",
    "description": "Colección de endpoints para el sistema SaaS de Gestión de Parqueos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login (Obtener Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@parkingo.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Perfil del Usuario",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["auth", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Dashboard y Catálogos",
      "item": [
        {
          "name": "Resumen Dashboard (Métricas en Vivo)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/summary",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "summary"]
            }
          }
        },
        {
          "name": "Listar Tipos de Vehículos y Tarifas",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/vehicle-types",
              "host": ["{{base_url}}"],
              "path": ["vehicle-types"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Ingresos (Vehicle Entry)",
      "item": [
        {
          "name": "Registrar Nueva Entrada de Vehículo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"license_plate\": \"ABC-999\",\n  \"vehicle_type_id\": 2,\n  \"notes\": \"Entrada de prueba API\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/entries",
              "host": ["{{base_url}}"],
              "path": ["entries"]
            }
          }
        },
        {
          "name": "Listar Vehículos Adentro",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/entries?status=inside",
              "host": ["{{base_url}}"],
              "path": ["entries"],
              "query": [{ "key": "status", "value": "inside" }]
            }
          }
        }
      ]
    },
    {
      "name": "4. Salidas y Cobros (Vehicle Exit)",
      "item": [
        {
          "name": "Calcular Tarifa / Cotizar Salida",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/exits/calculate?query=B 1234 KLM",
              "host": ["{{base_url}}"],
              "path": ["exits", "calculate"],
              "query": [{ "key": "query", "value": "B 1234 KLM" }]
            }
          }
        },
        {
          "name": "Completar Salida y Cobro",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entry_id\": 1,\n  \"payment_method\": \"cash\",\n  \"discount_amount\": 0.00,\n  \"notes\": \"Cobro exitoso en efectivo\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/exits/complete",
              "host": ["{{base_url}}"],
              "path": ["exits", "complete"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Transacciones y Reportes",
      "item": [
        {
          "name": "Historial de Transacciones (Hoy)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/transactions?period=today",
              "host": ["{{base_url}}"],
              "path": ["transactions"],
              "query": [{ "key": "period", "value": "today" }]
            }
          }
        },
        {
          "name": "Reporte Diario con Gráfico por Horas",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/reports/daily",
              "host": ["{{base_url}}"],
              "path": ["reports", "daily"]
            }
          }
        }
      ]
    }
  ]
}
